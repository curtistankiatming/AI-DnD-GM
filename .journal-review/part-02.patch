@@ -0,0 +1,121 @@
+'use strict';
+// Durable player knowledge is projected from confirmed engine records, not from
+// narration or the short chat transcript. Notes are kept separately and cannot
+// authorize mechanics. This is save continuity, not anti-cheat for edited saves.
+const {CLUES,STORY_NODES}=require('./content');
+const {QUESTS,PERSONAL}=require('./expansion');
+const RoadState=require('./road-state');
+const MAX_NOTES=12,MAX_NOTE_LENGTH=400;
+const safeText=(value,limit)=>typeof value==='string'?value.slice(0,limit):'';
+function normalizeNotes(raw){
+  const out=[],ids=new Set(),texts=new Set();let next=1;
+  for(const item of (Array.isArray(raw)?raw:[]).slice(0,100)){
+    const text=safeText(item?.text,MAX_NOTE_LENGTH).trim();
+    if(!text||texts.has(text))continue;
+    let id=typeof item.id==='string'&&/^note-[1-9][0-9]{0,5}$/.test(item.id)?item.id:'';
+    if(!id||ids.has(id)){while(ids.has('note-'+next))next++;id='note-'+next++;}
+    ids.add(id);texts.add(text);out.push({id,text,status:'player-note'});
+    if(out.length===MAX_NOTES)break;
+  }
+  return out;
+}
+function sync(state){
