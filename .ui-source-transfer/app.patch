+// Native dialog supplies modal keyboard behaviour; Escape always means Cancel.
+function askSessionDecision({ title, message, choices }) {
+  return new Promise(resolve => {
+    const previous = document.activeElement;
+    const dialog = createElement("dialog", "session-decision");
+    dialog.id = "sessionDecision";
+    dialog.setAttribute("aria-labelledby", "sessionDecisionTitle");
+    dialog.setAttribute("aria-describedby", "sessionDecisionMessage");
+    const heading = createElement("h2", "", title); heading.id = "sessionDecisionTitle";
+    const text = createElement("p", "", message); text.id = "sessionDecisionMessage";
+    const form = createElement("form", "session-decision-actions"); form.method = "dialog";
+    for (const [value, label] of choices) {
+      const button = createElement("button", value === "cancel" ? "btn btn-secondary" : "btn btn-primary", label);
+      button.type = "submit"; button.value = value; button.dataset.keepEnabled = "true";
+      if (value === "cancel") button.autofocus = true;
+      form.append(button);
+    }
+    dialog.append(heading, text, form); document.body.append(dialog);
+    dialog.addEventListener("close", () => {
+      const result = dialog.returnValue || "cancel"; dialog.remove();
+      if (previous?.isConnected && !previous.disabled) previous.focus();
+      resolve(result);
+    }, { once: true });
+    if (typeof dialog.showModal !== "function") { dialog.remove(); toast("This browser cannot show the safety confirmation. Nothing was changed.", "warning"); resolve("cancel"); }
+    else dialog.showModal();
+  });
 }
 
